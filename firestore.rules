rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMainAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email.lower() == 'buildolive4@gmail.com' &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true;
    }

    function hasActiveAdminGrant() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true &&
        exists(/databases/$(database)/documents/adminStaff/$(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.staffKey)) &&
        get(/databases/$(database)/documents/adminStaff/$(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.staffKey)).data.active == true;
    }

    function isAdmin() {
      return isMainAdmin() || hasActiveAdminGrant();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 120)) &&
        (!('country' in data) || data.country == null || (data.country is string && data.country.size() <= 60)) &&
        data.coins is int && data.coins >= 0 && data.coins <= 10000000 &&
        (!('walletBalancePaise' in data) || data.walletBalancePaise == null || (data.walletBalancePaise is int && data.walletBalancePaise >= 0 && data.walletBalancePaise <= 1000000000)) &&
        data.points is int && data.points >= 0 && data.points <= 10000000 &&
        data.level is int && data.level >= 1 && data.level <= 10 &&
        data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 20 &&
        (!('referredBy' in data) || data.referredBy == null || (data.referredBy is string && data.referredBy.size() <= 20)) &&
        data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 7 &&
        (!('lastDailyClaimDay' in data) || data.lastDailyClaimDay == null || (data.lastDailyClaimDay is string && data.lastDailyClaimDay.size() <= 16)) &&
        (!('lastSpinDay' in data) || data.lastSpinDay == null || (data.lastSpinDay is string && data.lastSpinDay.size() <= 16)) &&
        data.spinsToday is int && data.spinsToday >= 0 && data.spinsToday <= 10 &&
        data.mascotEnabled is bool &&
        data.darkMode is bool &&
        (!('blocked' in data) || data.blocked == null || data.blocked is bool) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.serviceId is string && data.serviceId.size() >= 1 && data.serviceId.size() <= 80 &&
        data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 120 &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 60 &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 60 &&
        data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
        data.coinPrice is int && data.coinPrice >= 0 && data.coinPrice <= 100000 &&
        data.status in ['COMPLETED', 'PENDING', 'CANCELLED'] &&
        data.contentLines is list && data.contentLines.size() <= 60 &&
        (data.contentLines.size() == 0 || data.contentLines[0] is string) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWalletTransaction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.txType in ['PURCHASE', 'SPEND', 'BONUS', 'DAILY_REWARD', 'SPIN_REWARD', 'REFERRAL', 'DEPOSIT', 'SERVICE_ORDER', 'REFUND'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 240)) &&
        data.coinDelta is int && data.coinDelta >= -1000000 && data.coinDelta <= 1000000 &&
        data.pointsDelta is int && data.pointsDelta >= -100000 && data.pointsDelta <= 100000 &&
        data.priceInr is int && data.priceInr >= 0 && data.priceInr <= 5000000 &&
        data.status in ['SUCCESSFUL', 'PENDING', 'FAILED', 'REFUNDED'] &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFavoritePack(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.serviceId is string && data.serviceId.size() >= 1 && data.serviceId.size() <= 80 &&
        data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 120 &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 60 &&
        data.contentText is string && data.contentText.size() >= 1 && data.contentText.size() <= 4000 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAppNotification(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 400 &&
        data.category in ['PURCHASE', 'REWARD', 'ORDER', 'LEVEL', 'SYSTEM'] &&
        data.read is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSupportTicket(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCatalogService(data) {
      return data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 60 &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 60 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.packType in ['HASHTAGS', 'CAPTIONS', 'BIOS', 'IDEAS'] &&
        data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
        data.coinPrice is int && data.coinPrice >= 0 && data.coinPrice <= 100000 &&
        data.trending is bool &&
        data.published is bool &&
        (!('providerName' in data) || (data.providerName is string && data.providerName.size() <= 100)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 250000)) &&
        data.contentLines is list && data.contentLines.size() >= 1 && data.contentLines.size() <= 60 &&
        data.contentLines[0] is string &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCatalogCategory(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.subtitle is string && data.subtitle.size() <= 100 &&
        data.description is string && data.description.size() <= 240 &&
        data.emoji is string && data.emoji.size() <= 16 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 250000)) &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 200 &&
        data.active is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidServiceFile(data) {
      return data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 80 &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 80 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.subtitle is string && data.subtitle.size() <= 160 &&
        data.emoji is string && data.emoji.size() <= 16 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048)) &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 500 &&
        data.active is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidServicePlan(data) {
      return data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 80 &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 80 &&
        data.fileId is string && data.fileId.size() >= 1 && data.fileId.size() <= 80 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 100 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.description is string && data.description.size() <= 300 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048)) &&
        data.pricePer1kPaise is int && data.pricePer1kPaise >= 1 && data.pricePer1kPaise <= 100000000 &&
        data.minQty is int && data.minQty >= 1 && data.minQty <= 10000000 &&
        data.maxQty is int && data.maxQty >= data.minQty && data.maxQty <= 100000000 &&
        data.inputHint is string && data.inputHint.size() >= 2 && data.inputHint.size() <= 120 &&
        data.presetTiers is list && data.presetTiers.size() <= 12 &&
        (data.presetTiers.size() == 0 || data.presetTiers[0] is string) &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 500 &&
        data.active is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidServiceOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 120)) &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 80 &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 80 &&
        data.fileId is string && data.fileId.size() >= 1 && data.fileId.size() <= 80 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 100 &&
        data.planId is string && data.planId.size() >= 1 && data.planId.size() <= 80 &&
        data.planName is string && data.planName.size() >= 2 && data.planName.size() <= 120 &&
        data.targetLink is string && data.targetLink.size() >= 2 && data.targetLink.size() <= 400 &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 100000000 &&
        data.totalPricePaise is int && data.totalPricePaise >= 1 && data.totalPricePaise <= 1000000000 &&
        data.paymentMethod in ['WALLET', 'UPI_DIRECT'] &&
        (!('utrNumber' in data) || (data.utrNumber is string && data.utrNumber.size() <= 40)) &&
        (!('paymentProofUrl' in data) || (data.paymentProofUrl is string && data.paymentProofUrl.size() <= 2048)) &&
        data.status in ['PENDING', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'] &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFundRequest(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        (!('userEmail' in data) || data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 120)) &&
        (!('requestType' in data) || data.requestType in ['WALLET_INR', 'COIN_PACK']) &&
        (!('packageId' in data) || (data.packageId is string && data.packageId.size() <= 80)) &&
        (!('packageName' in data) || (data.packageName is string && data.packageName.size() <= 100)) &&
        (!('coinsToCredit' in data) || (data.coinsToCredit is int && data.coinsToCredit >= 0 && data.coinsToCredit <= 10000000)) &&
        (!('pointsToCredit' in data) || (data.pointsToCredit is int && data.pointsToCredit >= 0 && data.pointsToCredit <= 100000)) &&
        data.amountPaise is int && data.amountPaise >= 100 && data.amountPaise <= 100000000 &&
        data.utrNumber is string && data.utrNumber.size() >= 6 && data.utrNumber.size() <= 40 &&
        (!('proofImageUrl' in data) || (data.proofImageUrl is string && data.proofImageUrl.size() <= 2048)) &&
        data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCoinPackage(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.coins is int && data.coins >= 10 && data.coins <= 1000000 &&
        data.bonusCoins is int && data.bonusCoins >= 0 && data.bonusCoins <= 500000 &&
        data.points is int && data.points >= 0 && data.points <= 10000 &&
        data.priceInr is int && data.priceInr >= 1 && data.priceInr <= 500000 &&
        (!('badge' in data) || (data.badge is string && data.badge.size() <= 40)) &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100 &&
        data.active is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAppConfig(data) {
      return data.maintenanceMode is bool &&
        data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300 &&
        data.announcementTitle is string && data.announcementTitle.size() <= 100 &&
        data.announcementBody is string && data.announcementBody.size() <= 300 &&
        data.welcomeCoins is int && data.welcomeCoins >= 0 && data.welcomeCoins <= 100000 &&
        data.referralBonusCoins is int && data.referralBonusCoins >= 0 && data.referralBonusCoins <= 100000 &&
        data.spinEnabled is bool &&
        data.dailyRewardsEnabled is bool &&
        (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 100)) &&
        (!('upiMerchantName' in data) || (data.upiMerchantName is string && data.upiMerchantName.size() <= 100)) &&
        (!('paymentQrUrl' in data) || (data.paymentQrUrl is string && data.paymentQrUrl.size() <= 2048)) &&
        (!('paymentInstructions' in data) || (data.paymentInstructions is string && data.paymentInstructions.size() <= 500)) &&
        (!('minDepositInr' in data) || (data.minDepositInr is int && data.minDepositInr >= 1 && data.minDepositInr <= 100000)) &&
        (!('coinRatePerInr' in data) || (data.coinRatePerInr is int && data.coinRatePerInr >= 1 && data.coinRatePerInr <= 10000)) &&
        (!('supportLink' in data) || (data.supportLink is string && data.supportLink.size() <= 300)) &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminStaff(data) {
      return data.staffName is string && data.staffName.size() >= 2 && data.staffName.size() <= 80 &&
        data.active is bool &&
        (!('linkedUid' in data) || (data.linkedUid is string && data.linkedUid.size() <= 128)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminGrant(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.staffKey is string && data.staffKey.size() >= 10 && data.staffKey.size() <= 80 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80 &&
        data.active is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAuditLog(data) {
      return data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 60 &&
        data.targetPath is string && data.targetPath.size() >= 1 && data.targetPath.size() <= 200 &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 300 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- USER PROFILE & PRIVATE SUBCOLLECTIONS ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isOwner(userId) &&
        incoming().userId == request.auth.uid &&
        !('blocked' in incoming()) &&
        (!('walletBalancePaise' in incoming()) || incoming().walletBalancePaise == 0) &&
        incoming().keys().hasAll([
          'userId', 'displayName', 'coins', 'points', 'level', 'referralCode',
          'dailyStreak', 'spinsToday', 'mascotEnabled', 'darkMode', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'email', 'country', 'coins', 'walletBalancePaise',
          'points', 'level', 'referralCode', 'referredBy', 'dailyStreak',
          'lastDailyClaimDay', 'lastSpinDay', 'spinsToday', 'mascotEnabled',
          'darkMode', 'createdAt', 'updatedAt'
        ]) &&
        isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'country', 'coins', 'walletBalancePaise', 'points', 'level',
              'dailyStreak', 'spinsToday', 'mascotEnabled', 'darkMode', 'blocked', 'updatedAt'
            ])
          ) ||
          (
            isOwner(userId) &&
            (!('blocked' in existing()) || existing().blocked == false) &&
            (
              // Action 1: Profile & preferences edit
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'country', 'mascotEnabled', 'darkMode', 'referredBy', 'updatedAt']) ||
              // Action 2: Coins, points, level, daily streak, or spin update
              incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'points', 'level', 'dailyStreak', 'lastDailyClaimDay', 'lastSpinDay', 'spinsToday', 'updatedAt']) ||
              // Action 3: Spend INR wallet balance on a service order (strictly decreasing; cannot self-credit)
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['walletBalancePaise', 'updatedAt']) &&
                ('walletBalancePaise' in existing()) &&
                incoming().walletBalancePaise < existing().walletBalancePaise
              ) ||
              // Action 4: Buy coins instantly using INR wallet balance (walletBalancePaise strictly decreases)
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['walletBalancePaise', 'coins', 'points', 'level', 'updatedAt']) &&
                ('walletBalancePaise' in existing()) &&
                incoming().walletBalancePaise < existing().walletBalancePaise
              )
            )
          )
        );

      allow delete: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // Orders subcollection (legacy creator packs)
      match /orders/{orderId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(orderId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(orderId) &&
          isOwner(userId) &&
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll([
            'userId', 'serviceId', 'serviceName', 'categoryId', 'categoryName',
            'itemCount', 'coinPrice', 'status', 'contentLines', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'serviceId', 'serviceName', 'categoryId', 'categoryName',
            'itemCount', 'coinPrice', 'status', 'contentLines', 'createdAt', 'updatedAt'
          ]) &&
          isValidOrder(incoming());

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(orderId) &&
          isValidOrder(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (
            (
              isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'contentLines', 'updatedAt'])
            ) ||
            (
              isOwner(userId) &&
              existing().status != 'CANCELLED' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['contentLines', 'updatedAt'])
            )
          );

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(orderId) && isAdmin();
      }

      // Immutable wallet transactions subcollection
      match /transactions/{txId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(txId) &&
          (isOwner(userId) || isAdmin()) &&
          incoming().userId == userId &&
          incoming().keys().hasAll([
            'userId', 'txType', 'title', 'coinDelta', 'pointsDelta', 'priceInr', 'status', 'createdAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'txType', 'title', 'description', 'coinDelta', 'pointsDelta', 'priceInr', 'status', 'createdAt'
          ]) &&
          isValidWalletTransaction(incoming());

        allow update: if false;
        allow delete: if false;
      }

      // Favorites subcollection
      match /favorites/{favId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(favId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(favId) &&
          isOwner(userId) &&
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll([
            'userId', 'serviceId', 'serviceName', 'categoryName', 'contentText', 'createdAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'serviceId', 'serviceName', 'categoryName', 'contentText', 'createdAt'
          ]) &&
          isValidFavoritePack(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(favId) && (isOwner(userId) || isAdmin());
      }

      // Notifications subcollection
      match /notifications/{notifId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(notifId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(notifId) &&
          (isOwner(userId) || isAdmin()) &&
          incoming().userId == userId &&
          incoming().keys().hasAll(['userId', 'title', 'body', 'category', 'read', 'createdAt']) &&
          incoming().keys().hasOnly(['userId', 'title', 'body', 'category', 'read', 'createdAt']) &&
          isValidAppNotification(incoming());

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(notifId) &&
          isValidAppNotification(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (isOwner(userId) || isAdmin()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(notifId) && (isOwner(userId) || isAdmin());
      }

      // Support tickets subcollection
      match /supportTickets/{ticketId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(ticketId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin());

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(ticketId) &&
          isOwner(userId) &&
          incoming().userId == request.auth.uid &&
          incoming().status == 'OPEN' &&
          incoming().keys().hasAll(['userId', 'subject', 'category', 'description', 'status', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'subject', 'category', 'description', 'status', 'createdAt', 'updatedAt']) &&
          isValidSupportTicket(incoming());

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(ticketId) &&
          isValidSupportTicket(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (
            (
              isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'updatedAt'])
            ) ||
            (
              isOwner(userId) &&
              existing().status != 'RESOLVED' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['description', 'updatedAt'])
            )
          );

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(ticketId) && isAdmin();
      }
    }

    // --- ADMIN-MANAGED CATALOG SERVICES (LEGACY CONTENT PACKS) ---
    match /catalogServices/{serviceId} {
      allow get: if isSignedIn() && isValidId(serviceId) && (isAdmin() || (resource != null && existing().published == true));
      allow list: if isSignedIn() && (isAdmin() || existing().published == true);

      allow create: if isSignedIn() &&
        isValidId(serviceId) &&
        isAdmin() &&
        incoming().keys().hasAll([
          'categoryId', 'categoryName', 'name', 'packType', 'itemCount',
          'coinPrice', 'trending', 'published', 'contentLines', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'categoryId', 'categoryName', 'name', 'packType', 'itemCount',
          'coinPrice', 'trending', 'published', 'providerName', 'photoUrl',
          'contentLines', 'createdAt', 'updatedAt'
        ]) &&
        isValidCatalogService(incoming());

      allow update: if isSignedIn() &&
        isValidId(serviceId) &&
        isValidCatalogService(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'categoryId', 'categoryName', 'name', 'packType', 'itemCount',
          'coinPrice', 'trending', 'published', 'providerName', 'photoUrl',
          'contentLines', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(serviceId) && isAdmin();
    }

    // --- ADMIN-MANAGED CATEGORIES (1:1 SQUARE GRID) ---
    match /catalogCategories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && (isAdmin() || (resource != null && existing().active == true));
      allow list: if isSignedIn() && (isAdmin() || existing().active == true);

      allow create: if isSignedIn() &&
        isValidId(categoryId) &&
        isAdmin() &&
        incoming().keys().hasAll([
          'name', 'subtitle', 'description', 'emoji', 'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'name', 'subtitle', 'description', 'emoji', 'photoUrl', 'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidCatalogCategory(incoming());

      allow update: if isSignedIn() &&
        isValidId(categoryId) &&
        isValidCatalogCategory(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'subtitle', 'description', 'emoji', 'photoUrl', 'sortOrder', 'active', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(categoryId) && isAdmin();
    }

    // --- ADMIN-MANAGED CUSTOM SERVICE FILES (SUB-CATEGORIES) ---
    match /serviceFiles/{fileId} {
      allow get: if isSignedIn() && isValidId(fileId) && (isAdmin() || (resource != null && existing().active == true));
      allow list: if isSignedIn() && (isAdmin() || existing().active == true);

      allow create: if isSignedIn() &&
        isValidId(fileId) &&
        isAdmin() &&
        incoming().keys().hasAll([
          'categoryId', 'categoryName', 'name', 'subtitle', 'emoji', 'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'categoryId', 'categoryName', 'name', 'subtitle', 'emoji', 'photoUrl', 'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidServiceFile(incoming());

      allow update: if isSignedIn() &&
        isValidId(fileId) &&
        isValidServiceFile(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'categoryId', 'categoryName', 'name', 'subtitle', 'emoji', 'photoUrl', 'sortOrder', 'active', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(fileId) && isAdmin();
    }

    // --- ADMIN-MANAGED SERVICE PLANS (INSIDE EACH FILE) ---
    match /servicePlans/{planId} {
      allow get: if isSignedIn() && isValidId(planId) && (isAdmin() || (resource != null && existing().active == true));
      allow list: if isSignedIn() && (isAdmin() || existing().active == true);

      allow create: if isSignedIn() &&
        isValidId(planId) &&
        isAdmin() &&
        incoming().keys().hasAll([
          'categoryId', 'categoryName', 'fileId', 'fileName', 'name', 'description',
          'pricePer1kPaise', 'minQty', 'maxQty', 'inputHint', 'presetTiers',
          'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'categoryId', 'categoryName', 'fileId', 'fileName', 'name', 'description',
          'photoUrl', 'pricePer1kPaise', 'minQty', 'maxQty', 'inputHint', 'presetTiers',
          'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidServicePlan(incoming());

      allow update: if isSignedIn() &&
        isValidId(planId) &&
        isValidServicePlan(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'categoryId', 'categoryName', 'fileId', 'fileName', 'name', 'description',
          'photoUrl', 'pricePer1kPaise', 'minQty', 'maxQty', 'inputHint', 'presetTiers',
          'sortOrder', 'active', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(planId) && isAdmin();
    }

    // --- USER SERVICE ORDERS (MANAGED BY ADMIN & CO-ADMIN) ---
    match /serviceOrders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (isAdmin() || (resource != null && existing().userId == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(orderId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'PENDING' &&
        !('adminNote' in incoming()) &&
        incoming().keys().hasAll([
          'userId', 'userName', 'categoryId', 'categoryName', 'fileId', 'fileName',
          'planId', 'planName', 'targetLink', 'quantity', 'totalPricePaise',
          'paymentMethod', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'userName', 'userEmail', 'categoryId', 'categoryName', 'fileId', 'fileName',
          'planId', 'planName', 'targetLink', 'quantity', 'totalPricePaise',
          'paymentMethod', 'utrNumber', 'paymentProofUrl', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidServiceOrder(incoming());

      allow update: if isAdmin() &&
        isValidId(orderId) &&
        isValidServiceOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(orderId);
    }

    // --- USER INR FUND / COIN PURCHASE REQUESTS (APPROVED BY ADMIN & CO-ADMIN) ---
    match /fundRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (isAdmin() || (resource != null && existing().userId == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'PENDING' &&
        !('adminNote' in incoming()) &&
        incoming().keys().hasAll([
          'userId', 'userName', 'amountPaise', 'utrNumber', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'userName', 'userEmail', 'requestType', 'packageId', 'packageName',
          'coinsToCredit', 'pointsToCredit', 'amountPaise', 'utrNumber',
          'proofImageUrl', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidFundRequest(incoming());

      allow update: if isAdmin() &&
        isValidId(requestId) &&
        isValidFundRequest(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().amountPaise == existing().amountPaise &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(requestId);
    }

    // --- ADMIN-MANAGED COIN PACKAGES ---
    match /coinPackages/{packageId} {
      allow get: if isSignedIn() && isValidId(packageId) && (isAdmin() || (resource != null && existing().active == true));
      allow list: if isSignedIn() && (isAdmin() || existing().active == true);

      allow create: if isSignedIn() &&
        isValidId(packageId) &&
        isAdmin() &&
        incoming().keys().hasAll([
          'name', 'coins', 'bonusCoins', 'points', 'priceInr', 'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'name', 'coins', 'bonusCoins', 'points', 'priceInr', 'badge', 'sortOrder', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidCoinPackage(incoming());

      allow update: if isSignedIn() &&
        isValidId(packageId) &&
        isValidCoinPackage(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'coins', 'bonusCoins', 'points', 'priceInr', 'badge', 'sortOrder', 'active', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(packageId) && isAdmin();
    }

    // --- GLOBAL REAL-TIME APP CONFIG & UPI PAYMENT SETTINGS ---
    match /appConfig/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(configId) &&
        incoming().keys().hasAll([
          'maintenanceMode', 'maintenanceMessage', 'announcementTitle', 'announcementBody',
          'welcomeCoins', 'referralBonusCoins', 'spinEnabled', 'dailyRewardsEnabled', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'maintenanceMode', 'maintenanceMessage', 'announcementTitle', 'announcementBody',
          'welcomeCoins', 'referralBonusCoins', 'spinEnabled', 'dailyRewardsEnabled',
          'upiId', 'upiMerchantName', 'paymentQrUrl', 'paymentInstructions',
          'minDepositInr', 'coinRatePerInr', 'supportLink', 'updatedAt'
        ]) &&
        isValidAppConfig(incoming());

      allow update: if isAdmin() &&
        isValidId(configId) &&
        isValidAppConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'maintenanceMode', 'maintenanceMessage', 'announcementTitle', 'announcementBody',
          'welcomeCoins', 'referralBonusCoins', 'spinEnabled', 'dailyRewardsEnabled',
          'upiId', 'upiMerchantName', 'paymentQrUrl', 'paymentInstructions',
          'minDepositInr', 'coinRatePerInr', 'supportLink', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // --- ADMIN STAFF CREDENTIALS (MAIN ADMIN ONLY FOR MANAGEMENT) ---
    match /adminStaff/{staffKey} {
      allow get: if isSignedIn() && isValidId(staffKey);
      allow list: if isMainAdmin();

      allow create: if isMainAdmin() &&
        isValidId(staffKey) &&
        incoming().keys().hasAll(['staffName', 'active', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['staffName', 'active', 'linkedUid', 'createdAt', 'updatedAt']) &&
        isValidAdminStaff(incoming());

      allow update: if isValidId(staffKey) &&
        isValidAdminStaff(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            isMainAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['staffName', 'active', 'linkedUid', 'updatedAt'])
          ) ||
          (
            isSignedIn() &&
            existing().active == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['linkedUid', 'updatedAt']) &&
            incoming().linkedUid == request.auth.uid
          )
        );

      allow delete: if isMainAdmin() && isValidId(staffKey);
    }

    // --- ACTIVATED ADMIN SESSIONS ---
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isMainAdmin());
      allow list: if isMainAdmin();

      allow create: if isSignedIn() &&
        isValidId(adminUid) &&
        request.auth.uid == adminUid &&
        incoming().userId == request.auth.uid &&
        incoming().active == true &&
        incoming().keys().hasAll(['userId', 'staffKey', 'displayName', 'active', 'createdAt']) &&
        incoming().keys().hasOnly(['userId', 'staffKey', 'displayName', 'active', 'createdAt']) &&
        isValidAdminGrant(incoming()) &&
        exists(/databases/$(database)/documents/adminStaff/$(incoming().staffKey)) &&
        get(/databases/$(database)/documents/adminStaff/$(incoming().staffKey)).data.active == true;

      allow update: if isMainAdmin() &&
        isValidId(adminUid) &&
        isValidAdminGrant(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['active', 'displayName']);

      allow delete: if isSignedIn() && isValidId(adminUid) && (isMainAdmin() || request.auth.uid == adminUid);
    }

    // --- IMMUTABLE ADMIN AUDIT LOGS ---
    match /adminAuditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(logId) &&
        incoming().actorUid == request.auth.uid &&
        incoming().keys().hasAll(['actorUid', 'actorName', 'action', 'targetPath', 'summary', 'createdAt']) &&
        incoming().keys().hasOnly(['actorUid', 'actorName', 'action', 'targetPath', 'summary', 'createdAt']) &&
        isValidAuditLog(incoming());

      allow update: if false;
      allow delete: if false;
    }
  }
}
