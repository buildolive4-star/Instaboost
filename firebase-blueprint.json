{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account, coin balance, INR wallet balance (paise), points, level, streak, suspension flag, and preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID matching document ID." },
        "displayName": { "type": "string", "description": "User display name." },
        "email": { "type": "string", "description": "User email address (private to owner/admin)." },
        "country": { "type": "string", "description": "Selected country name." },
        "coins": { "type": "integer", "description": "Current virtual coin balance." },
        "walletBalancePaise": { "type": "integer", "description": "INR wallet balance stored in paise (100 = Rs 1.00)." },
        "points": { "type": "integer", "description": "Accumulated reward points." },
        "level": { "type": "integer", "description": "Creator level from 1 to 10." },
        "referralCode": { "type": "string", "description": "Unique referral code for sharing." },
        "referredBy": { "type": "string", "description": "Optional referral code used during setup." },
        "dailyStreak": { "type": "integer", "description": "Consecutive daily check-in streak (0-7)." },
        "lastDailyClaimDay": { "type": "string", "description": "ISO date yyyy-MM-dd of last daily reward claim." },
        "lastSpinDay": { "type": "string", "description": "ISO date yyyy-MM-dd of last lucky wheel spin." },
        "spinsToday": { "type": "integer", "description": "Number of spins completed today." },
        "mascotEnabled": { "type": "boolean", "description": "Whether floating mascot companion is visible." },
        "darkMode": { "type": "boolean", "description": "Whether dark mode preference is active." },
        "blocked": { "type": "boolean", "description": "Admin-controlled account suspension flag." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Immutable creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "displayName", "coins", "points", "level", "referralCode", "dailyStreak", "spinsToday", "mascotEnabled", "darkMode", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchased digital content pack order belonging to a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "itemCount": { "type": "integer" },
        "coinPrice": { "type": "integer" },
        "status": { "type": "string", "enum": ["COMPLETED", "PENDING", "CANCELLED"] },
        "contentLines": { "type": "array", "description": "Unlocked hashtags, captions, or bio lines." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceId", "serviceName", "categoryId", "categoryName", "itemCount", "coinPrice", "status", "contentLines", "createdAt", "updatedAt"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Immutable wallet transaction ledger entry for coin additions, spends, INR deposits, service orders, refunds, bonuses, and rewards.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "txType": { "type": "string", "enum": ["PURCHASE", "SPEND", "BONUS", "DAILY_REWARD", "SPIN_REWARD", "REFERRAL", "DEPOSIT", "SERVICE_ORDER", "REFUND"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "coinDelta": { "type": "integer" },
        "pointsDelta": { "type": "integer" },
        "priceInr": { "type": "integer" },
        "status": { "type": "string", "enum": ["SUCCESSFUL", "PENDING", "FAILED", "REFUNDED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "txType", "title", "coinDelta", "pointsDelta", "priceInr", "status", "createdAt"]
    },
    "FavoritePack": {
      "title": "FavoritePack",
      "description": "User-saved favorite hashtag pack, caption set, or AI-generated bio.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "categoryName": { "type": "string" },
        "contentText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceId", "serviceName", "categoryName", "contentText", "createdAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app notification entry for purchases, orders, deposits, daily rewards, and level-ups.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string", "enum": ["PURCHASE", "REWARD", "ORDER", "LEVEL", "SYSTEM"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "body", "category", "read", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "User help & support ticket with status tracking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "IN_PROGRESS", "RESOLVED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "category", "description", "status", "createdAt", "updatedAt"]
    },
    "CatalogService": {
      "title": "CatalogService",
      "description": "Admin-managed digital content pack published to the Services catalog.",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "name": { "type": "string" },
        "packType": { "type": "string", "enum": ["HASHTAGS", "CAPTIONS", "BIOS", "IDEAS"] },
        "itemCount": { "type": "integer" },
        "coinPrice": { "type": "integer" },
        "trending": { "type": "boolean" },
        "published": { "type": "boolean" },
        "providerName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "contentLines": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["categoryId", "categoryName", "name", "packType", "itemCount", "coinPrice", "trending", "published", "contentLines", "createdAt", "updatedAt"]
    },
    "CatalogCategory": {
      "title": "CatalogCategory",
      "description": "Admin-managed service category shown in 2-column 1:1 square grid with ImgBB photo.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "emoji": { "type": "string" },
        "photoUrl": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "subtitle", "description", "emoji", "sortOrder", "active", "createdAt", "updatedAt"]
    },
    "ServiceFile": {
      "title": "ServiceFile",
      "description": "Custom service file / sub-category inside a CatalogCategory (e.g., Instagram Followers, Reel Views, Likes).",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "emoji": { "type": "string" },
        "photoUrl": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["categoryId", "categoryName", "name", "subtitle", "emoji", "sortOrder", "active", "createdAt", "updatedAt"]
    },
    "ServicePlan": {
      "title": "ServicePlan",
      "description": "Orderable service plan inside a ServiceFile with price per 1k in paise, quantity bounds, input hint, and preset discount tiers.",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "fileId": { "type": "string" },
        "fileName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "photoUrl": { "type": "string" },
        "pricePer1kPaise": { "type": "integer" },
        "minQty": { "type": "integer" },
        "maxQty": { "type": "integer" },
        "inputHint": { "type": "string" },
        "presetTiers": { "type": "array", "description": "List of qty:discountPct strings such as 100:0, 2000:5." },
        "sortOrder": { "type": "integer" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["categoryId", "categoryName", "fileId", "fileName", "name", "description", "pricePer1kPaise", "minQty", "maxQty", "inputHint", "presetTiers", "sortOrder", "active", "createdAt", "updatedAt"]
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "description": "User-submitted service order paid via INR wallet or direct UPI QR + UTR, managed by Admin and Co-Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "fileId": { "type": "string" },
        "fileName": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "targetLink": { "type": "string" },
        "quantity": { "type": "integer" },
        "totalPricePaise": { "type": "integer" },
        "paymentMethod": { "type": "string", "enum": ["WALLET", "UPI_DIRECT"] },
        "utrNumber": { "type": "string" },
        "paymentProofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "CANCELLED"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "categoryId", "categoryName", "fileId", "fileName", "planId", "planName", "targetLink", "quantity", "totalPricePaise", "paymentMethod", "status", "createdAt", "updatedAt"]
    },
    "FundRequest": {
      "title": "FundRequest",
      "description": "User UPI payment request for INR wallet top-up or Coin Package purchase with UTR and optional ImgBB proof screenshot, approved by Admin or Co-Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "requestType": { "type": "string", "enum": ["WALLET_INR", "COIN_PACK"] },
        "packageId": { "type": "string" },
        "packageName": { "type": "string" },
        "coinsToCredit": { "type": "integer" },
        "pointsToCredit": { "type": "integer" },
        "amountPaise": { "type": "integer" },
        "utrNumber": { "type": "string" },
        "proofImageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "amountPaise", "utrNumber", "status", "createdAt", "updatedAt"]
    },
    "CoinPackage": {
      "title": "CoinPackage",
      "description": "Admin-managed coin bundle available in Wallet.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "coins": { "type": "integer" },
        "bonusCoins": { "type": "integer" },
        "points": { "type": "integer" },
        "priceInr": { "type": "integer" },
        "badge": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "coins", "bonusCoins", "points", "priceInr", "sortOrder", "active", "createdAt", "updatedAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global real-time configuration including UPI payment details, QR code URL, support link, and feature switches.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string" },
        "announcementTitle": { "type": "string" },
        "announcementBody": { "type": "string" },
        "welcomeCoins": { "type": "integer" },
        "referralBonusCoins": { "type": "integer" },
        "spinEnabled": { "type": "boolean" },
        "dailyRewardsEnabled": { "type": "boolean" },
        "upiId": { "type": "string" },
        "upiMerchantName": { "type": "string" },
        "paymentQrUrl": { "type": "string" },
        "paymentInstructions": { "type": "string" },
        "minDepositInr": { "type": "integer" },
        "coinRatePerInr": { "type": "integer" },
        "supportLink": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["maintenanceMode", "maintenanceMessage", "announcementTitle", "announcementBody", "welcomeCoins", "referralBonusCoins", "spinEnabled", "dailyRewardsEnabled", "updatedAt"]
    },
    "AdminStaff": {
      "title": "AdminStaff",
      "description": "Hashed credential entry created by Main Admin (Name + Password hashed into document ID; no plaintext password stored).",
      "type": "object",
      "properties": {
        "staffName": { "type": "string" },
        "active": { "type": "boolean" },
        "linkedUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["staffName", "active", "createdAt", "updatedAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Active admin session binding between a verified Firebase Auth UID and an active AdminStaff credential.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "staffKey": { "type": "string" },
        "displayName": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "staffKey", "displayName", "active", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable log of administrative changes.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "action": { "type": "string" },
        "targetPath": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorName", "action", "targetPath", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile, coin & INR wallet balance, points, level, streak, suspension flag, and app settings."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "User purchased digital content pack orders."
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "User immutable wallet transaction ledger."
    },
    "/users/{userId}/favorites/{favId}": {
      "schema": { "$ref": "#/entities/FavoritePack" },
      "description": "User saved favorite content packs."
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "User notifications."
    },
    "/users/{userId}/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "User support tickets."
    },
    "/catalogServices/{serviceId}": {
      "schema": { "$ref": "#/entities/CatalogService" },
      "description": "Admin-published dynamic creator services with editable provider and photo."
    },
    "/catalogCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/CatalogCategory" },
      "description": "Admin-managed service categories displayed in a 2-column 1:1 grid."
    },
    "/serviceFiles/{fileId}": {
      "schema": { "$ref": "#/entities/ServiceFile" },
      "description": "Admin-managed custom service files / sub-categories inside each category."
    },
    "/servicePlans/{planId}": {
      "schema": { "$ref": "#/entities/ServicePlan" },
      "description": "Admin-managed orderable service plans inside each service file."
    },
    "/serviceOrders/{orderId}": {
      "schema": { "$ref": "#/entities/ServiceOrder" },
      "description": "User service orders paid by wallet or UPI QR, fulfilled by Admin and Co-Admin."
    },
    "/fundRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FundRequest" },
      "description": "User INR wallet deposit requests with UTR and payment proof screenshot."
    },
    "/coinPackages/{packageId}": {
      "schema": { "$ref": "#/entities/CoinPackage" },
      "description": "Admin-configured coin wallet packages."
    },
    "/appConfig/{configId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Global real-time app control switches, UPI payment settings, QR code, and banners."
    },
    "/adminStaff/{staffKey}": {
      "schema": { "$ref": "#/entities/AdminStaff" },
      "description": "Main-admin-managed staff credentials keyed by 128-bit SHA-256 hash."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Activated admin sessions bound to authenticated UIDs."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable admin action audit trail."
    }
  }
}
